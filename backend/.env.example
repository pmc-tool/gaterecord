# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://shahadat:root@localhost:5432/gate_management
DATABASE_SSL=false

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Cloud Plus TCP Server (for direct gate control)
TCP_PORT=8002

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Email Configuration
# Development (Mailpit):
#   SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURE=false
# Production (STARTTLS - port 587):
#   SMTP_HOST=smtp.example.com, SMTP_PORT=587, SMTP_SECURE=false
# Production (SSL - port 465):
#   SMTP_HOST=smtp.example.com, SMTP_PORT=465, SMTP_SECURE=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Yaad <noreply@gaterecord.com>

# Logging
LOG_LEVEL=debug

# Auth (Keycloak / upstream account service)
# gaterecord performs NO authentication of its own: the account service owns
# signup, login and password flows. These only VERIFY the RS256 access token.
KEYCLOAK_DOMAIN=https://identifier.yaad.global
KEYCLOAK_REALM=yaad
# Must match the client the account service authenticates users with (audience).
KEYCLOAK_CLIENT_ID=yaad-admin

# User mirror ingest (POST /api/v1/user-sync)
# Comma-separated keys accepted in the `x-api-key` header when the account
# service pushes users into the global `users` mirror. Same variable name and
# header as the sibling `ride` and `core` services, so one operator configures
# all three identically.
# Fails closed: if unset, every sync request is rejected.
VALID_API_KEYS=change-me-generate-a-random-key

# Account service identity provisioning (OUTBOUND: gaterecord -> account)
# When a building admin adds a resident/security/staff member, gaterecord asks
# the account service to create the real platform identity (Keycloak user,
# pre-verified) and to email that person their password. gaterecord no longer
# generates, stores or emails passwords for admin-created users.
#
# Base URL MUST include the account service's version prefix: its controller
# resolves to POST /v1/internal/users, and gaterecord appends /internal/users.
ACCOUNT_API_URL=http://localhost:4001/v1
# Sent as the `x-service-key` header. Must appear in the account service's
# SERVICE_API_KEYS list. Fails closed: if unset, user creation is refused
# rather than silently falling back to a local-only, un-loggable-in user.
ACCOUNT_SERVICE_KEY=change-me-must-match-account-SERVICE_API_KEYS
# Optional. Request timeout in milliseconds (default 15000).
ACCOUNT_API_TIMEOUT_MS=15000
# Starting password of every NEW account an admin adds on the Users or Residents
# page (admins cannot type one). Emailed to the person, who should change it
# after first sign-in (platform profile > change password; the account service
# stores it as a normal, non-temporary Keycloak credential). An email that already has an account keeps its own password.
# Min 8 characters (account service rule). Unset/empty/too short = the account
# service generates a random password per account, and a warning is logged.
# Keep the real value out of version control. Left empty here on purpose so a
# verbatim copy of this file takes the logged random-password fallback.
GATE_DEFAULT_USER_PASSWORD=

# Multi-building memberships (specs/003-multi-building-memberships/runbook.md)
# The single rollout flag. 'on' = every request acts as the membership chosen
# with the X-Gate-Membership header, GET /memberships/me is live, gate
# credentials are checked against memberships, and one person may hold roles
# in several buildings. Anything else (or unset) = today's single-building
# behaviour. Flip only in the cutover window described in the runbook.
GATE_MEMBERSHIP_CONTEXT=off
# Creating additional buildings from onboarding: 'open' lets any signed-in
# person create another building, up to MAX_BUILDINGS_CREATED_PER_PERSON.
# 'plan' allows it only for an active building admin of a building whose plan
# has the multi_building feature; 'off' allows a building only to someone with
# no building at all. Any other value is treated as 'off'. The first building
# is always allowed (only the cap applies to it).
ONBOARDING_MULTI_BUILDING_POLICY=open
# Buildings one person may create through onboarding (negative = no limit).
MAX_BUILDINGS_CREATED_PER_PERSON=5

# Safety valves for shared databases (leave unset).
# TypeORM synchronize and `npm run seed` refuse any database that is not local
# (localhost, 127.0.0.1, ::1, gate_postgres). Set these only with the database
# owner's approval.
# ALLOW_REMOTE_SYNC=1
# SEED_ALLOW_REMOTE=1
# Opt-in local fixtures for the role/building picker (npm run seed, local only).
# SEED_MULTI_MEMBERSHIP=1
# SEED_MULTI_MEMBERSHIP_EMAIL=multi.person@gaterecord.test

# Tests: database suites (test/db) run only against this local, disposable
# database (its name must contain "test"); they are skipped when it is unset.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/gate_test
