# Ignore everything except frontend and backend
/*
!/frontend/
!/backend/
!/.gitignore
!/README.md
!/docker-compose.yml
!/docker-compose.prod.yml
!/CLAUDE.md

# Dependencies
node_modules/

# Build outputs
dist/
build/

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Test coverage
coverage/

# TypeScript cache
*.tsbuildinfo
