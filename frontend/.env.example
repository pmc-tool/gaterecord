VITE_API_URL=https://dev-api.gaterecord.com/api/v1
VITE_WS_URL=https://dev-api.gaterecord.com

# YAAD account sign-in (Keycloak, OIDC code + PKCE). Leave all three empty to
# offer only the local email + password login. The client must be a PUBLIC
# client in the realm with PKCE S256, redirect URI <frontend origin>/auth/callback,
# post-logout redirect URI <frontend origin>/login and web origin <frontend origin>.
# Needs HTTPS (or localhost): PKCE uses the browser's crypto.subtle.
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
