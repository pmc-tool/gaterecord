# ===========================================
# GateRecord Production Environment Variables
# ===========================================

# Node Environment
NODE_ENV=production

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=gate_management
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_SSL=false

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://redis:6379

# ===========================================
# JWT Authentication
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_at_least_32_characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_secret_here_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# Application Settings
# ===========================================
PORT=3001
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===========================================
# Email Configuration (SMTP)
# ===========================================
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourdomain.com
SMTP_SECURE=false

# ===========================================
# Cloud Plus Controller Settings
# ===========================================
# Controller heartbeat timeout (seconds)
CONTROLLER_HEARTBEAT_TIMEOUT=120
# Maximum pending commands per controller
MAX_PENDING_COMMANDS=10
# Command expiration time (seconds)
COMMAND_EXPIRATION=300

# ===========================================
# Security Settings
# ===========================================
# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# API key settings
API_KEY_HASH_ROUNDS=12

# ===========================================
# Audit Log Settings
# ===========================================
# Days to retain audit logs (0 = forever)
AUDIT_LOG_RETENTION_DAYS=90

# ===========================================
# Monitoring (Grafana)
# ===========================================
GRAFANA_PASSWORD=your_grafana_admin_password

# ===========================================
# Frontend Settings
# ===========================================
# API URL for frontend (set in frontend/.env)
VITE_API_URL=https://api.yourdomain.com
VITE_WS_URL=wss://api.yourdomain.com
